@component-name = "portal-lima"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Redirect";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "page1");

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "page2");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "Test Site");

			User.logoutPG();
		}
	}

	@description = "This test checks that an Alias will override a Pattern."
	@priority = "5"
	test AliasTakesPrecedenceOverPattern {
		var portalURL = PropsUtil.get("portal.url");

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "page3");

		JSONRedirect.addRedirect(
			destinationURL = "${portalURL}/web/guest/page2",
			groupName = "Guest",
			sourceURL = "page1");

		Redirect.openToPatterns(siteURLKey = "guest");

		Redirect.addPattern(
			destinationIndex = "0",
			destinationURL = "/$1/page3",
			pattern = "(.*)/page1$",
			patternIndex = "0");

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation(value1 = "${portalURL}/web/guest/page2");

		JSONRedirect.deleteEntry(
			destinationURL = "${portalURL}/web/guest/page2",
			groupName = "Guest");

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation(value1 = "${portalURL}/web/guest/page3");
	}

	@description = "This test checks that a Pattern can be updated."
	@priority = "5"
	test CanUpdatePattern {
		var portalURL = PropsUtil.get("portal.url");

		Redirect.openToPatterns(siteURLKey = "guest");

		Redirect.addPattern(
			destinationIndex = "0",
			destinationURL = "/$1/changethis",
			pattern = "(.*)/page1$",
			patternIndex = "0");

		Redirect.addPattern(
			destinationIndex = "0",
			destinationURL = "/$1/page2",
			pattern = "(.*)/page1$",
			patternIndex = "0");

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation(value1 = "${portalURL}/web/guest/page2");
	}

	@description = "This test checks that when there are multiple Patterns, the first one that matches the URL will be applied."
	@priority = "5"
	test FirstMatchingPatternWillBeApplied {
		var portalURL = PropsUtil.get("portal.url");

		Redirect.openToPatterns(siteURLKey = "guest");

		Redirect.addPattern(
			destinationIndex = "0",
			destinationURL = "test",
			pattern = "test",
			patternIndex = "0");

		Redirect.addPattern(
			destinationIndex = "1",
			destinationURL = "/$1/page2",
			pattern = "(.*)/page1$",
			patternIndex = "1");

		Redirect.addPattern(
			destinationIndex = "2",
			destinationURL = "https://www.liferay.com",
			pattern = "(.*)/page1$",
			patternIndex = "2");

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation(value1 = "${portalURL}/web/guest/page2");

		Redirect.openToPatterns(siteURLKey = "guest");

		Redirect.removePattern(index = "1");

		Button.clickSave();

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation.assertPartialLocation(value1 = "www.liferay.com");
	}

	@description = "This test checks that when there are multiple Patterns, the first one that matches the URL will be applied."
	@priority = "5"
	test WillGenerateErrorIfInvalid {
		var portalURL = PropsUtil.get("portal.url");

		Redirect.openRedirectAdmin(siteURLKey = "guest");

		AssertElementPresent(
			key_tab = "Aliases",
			locator1 = "NavTab#ACTIVE_TAB_LINK");

		Redirect.gotoPatternsTab();

		Redirect.addPattern(
			destinationIndex = "0",
			destinationURL = "https://www.liferay.com",
			error = "true",
			pattern = "(",
			patternIndex = "0");

		Navigator.openSpecificURL(url = "${portalURL}/web/guest/page1");

		AssertLocation(value1 = "${portalURL}/web/guest/page1");
	}

}