@component-name = "portal-document-management"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Documents Management";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			DMDocument.tearDownCP();

			User.logoutPG();
		}
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test AddSeparatorOnFormByDragAndDrop {
		property portal.acceptance = "false";

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		DMDocumentType.add(
			dmDocumentTypeDescription = "Document Separator Type Description",
			dmDocumentTypeFieldNames = "Separator",
			dmDocumentTypeName = "Document Separator Type");

		DMDocumentType.viewCP(dmDocumentTypeName = "Document Separator Type");
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test DeleteSeparatorOnBuilder {
		property portal.acceptance = "false";

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		LexiconEntry.gotoAdd();

		PortletEntry.inputName(name = "Document Separator Type");

		for (var fieldFields : list "Separator,Image") {
			DataEngine.addField(
				fieldFieldLabel = "${fieldFields}",
				fieldName = "${fieldFields}");
		}

		DDLDataDefinition.save();

		LexiconEntry.openEntryMenu(rowEntry = "Document Separator Type");

		MenuItem.click(menuItem = "Edit");

		AssertClick.assertPartialTextClickAt(
			key_fieldFieldLabel = "Separator",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER",
			value1 = "Separator");

		Click(
			key_text = "Separator",
			locator1 = "Icon#ANY_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Delete");

		DDLDataDefinition.save();

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		LexiconEntry.openEntryMenu(rowEntry = "Document Separator Type");

		MenuItem.click(menuItem = "Edit");

		AssertElementNotPresent(
			key_fieldFieldLabel = "Separator",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER_LABEL");
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "4"
	test DuplicateSeparatorOnBuilder {
		property portal.acceptance = "false";

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		LexiconEntry.gotoAdd();

		PortletEntry.inputName(name = "Document Separator Type");

		DataEngine.addField(
			fieldFieldLabel = "Separator",
			fieldName = "Separator");

		AssertClick.assertPartialTextClickAt(
			key_fieldFieldLabel = "Separator",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER",
			value1 = "Separator");

		Click(
			key_text = "Separator",
			locator1 = "Icon#ANY_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Duplicate");

		DDLDataDefinition.save();

		LexiconEntry.openEntryMenu(rowEntry = "Document Separator Type");

		MenuItem.click(menuItem = "Edit");

		for (var fieldFieldLabel : list "Separator,Copy of Separator") {
			DataEngine.viewField(
				fieldFieldLabel = "${fieldFieldLabel}",
				fieldName = "Separator");
		}
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test EditHelpTextOfSeparator {
		property portal.acceptance = "false";

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		LexiconEntry.gotoAdd();

		PortletEntry.inputName(name = "Document Separator Type");

		DataEngine.addField(
			fieldFieldLabel = "Separator",
			fieldName = "Separator");

		DataEngine.editFieldTip(
			fieldFieldLabel = "Separator",
			fieldHelp = "This is Separator help text.");

		DDLDataDefinition.save();

		LexiconEntry.openEntryMenu(rowEntry = "Document Separator Type");

		MenuItem.click(menuItem = "Edit");

		DataEngine.viewField(
			fieldFieldLabel = "Separator",
			fieldHelp = "This is Separator help text.",
			fieldName = "Separator");
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test EditLabelOfSeparator {
		property portal.acceptance = "false";

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		DMDocumentType.add(
			dmDocumentTypeDescription = "Document Separator Type Description",
			dmDocumentTypeFieldNames = "Separator",
			dmDocumentTypeName = "Document Separator Type");

		DMNavigator.openDocumentsAndMediaAdmin(siteURLKey = "guest");

		DMNavigator.gotoDocumentType();

		DMDocumentType.edit(
			dmDocumentTypeName = "Document Separator Type",
			dmDocumentTypeNameEdit = "Document Separator Type Edit",
			fieldFieldLabel = "Separator",
			fieldFieldLabelEdit = "Separator Test");

		DMDocumentType.viewCP(dmDocumentTypeName = "Document Separator Type Edit");
	}

	@description = "This is a test for LPS-98081. As a Developer, I want to use separators"
	@ignore = "true"
	@priority = "5"
	test EditReferenceOfSeparator {
